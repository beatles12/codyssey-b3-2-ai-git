+"""할 일 검색 기능."""
+
+from todo_app.app import list_todos
+
+
+def search_todos(keyword):
+    """제목에 keyword 가 들어간 할 일만 돌려준다."""
+    keyword = keyword.strip().lower()
+    return [todo for todo in list_todos()
+            if keyword in todo['title'].lower()]
